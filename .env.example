# Native local development starts its own project-local PostgreSQL cluster.
# Existing deployments can supply DATABASE_URL instead.
# DATABASE_URL=postgresql://debugroom:REPLACE@127.0.0.1:55432/postgres
DEBUGROOM_ORIGIN=http://127.0.0.1:5173
DEBUGROOM_EXECUTION_MODE=docker
PYTHON_CONTAINER_RUNTIME=runsc
CPP_CONTAINER_RUNTIME=runc
# macOS Colima profile used by the local worker:
# DOCKER_CONTEXT=colima-debugroom
# Production requires NODE_ENV=production, HTTPS, database and worker credentials,
# and real GitHub OAuth client credentials. Never commit filled-in secrets.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DEBUGROOM_RUNNER_TOKEN=
# TRACE_BUCKET=
# AWS_REGION=
# Hosted C++ remains disabled unless a dedicated VM profile is validated.
# DEBUGROOM_ENABLE_CPP=1
# CPP_RUNTIME_PROFILE=dedicated-vm
